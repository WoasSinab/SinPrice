{
  "manifest_version": 3,
  "name": "SinPrice",
  "version": "1.0.1",
  "description": "Live USD and Gold 18K tracker with instant cache loading and badge notifications.",
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.tgju.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}